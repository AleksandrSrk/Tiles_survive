"""Рисует шаблон карты типа 1 (изометрия), залитый владельцами. Белый фон, теги + названия уровней по центру плиток."""
import json, math, os
import numpy as np, cv2
from PIL import Image, ImageDraw, ImageFont
from shapely.geometry import Polygon, box
from shapely import affinity

BASE = r"D:\PROJECT\TilesSurviveMap"
TEMPLATE = BASE + r"\assets\reference\map_type1_v2.json"
NAMES = {1: "Деревня", 2: "Завод", 3: "Городок", 4: "Мегаполис", 5: "Центр исследований", 6: "Военная база", 7: "Аркадия"}
RINGCOL = {7: (150, 200, 140), 6: (205, 205, 255), 5: (200, 255, 255), 4: (230, 205, 255), 3: (255, 230, 200), 2: (200, 235, 205), 1: (205, 225, 250)}
FONT_BOLD = [r"C:\Windows\Fonts\arialbd.ttf", r"C:\Windows\Fonts\segoeuib.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSansCondensed-Bold.ttf"]


def _font(sz):
    for p in FONT_BOLD:
        if os.path.exists(p):
            return ImageFont.truetype(p, sz)
    return ImageFont.load_default()


def render(owners, out_png, template_path=TEMPLATE, scale=2.0):
    """owners: {cell_id: {"tag": str|None, "rgb": [r,g,b]}}; пустое -> цвет кольца."""
    T = json.load(open(template_path, encoding="utf-8"))["cells"]
    allp = [p for c in T for p in c["iso_polygon"]]
    mnx = min(p[0] for p in allp); mny = min(p[1] for p in allp)
    Wd = int((max(p[0] for p in allp) - mnx) * scale) + 80
    Hd = int((max(p[1] for p in allp) - mny) * scale) + 80
    tr = lambda p: ((p[0] - mnx) * scale + 40, (p[1] - mny) * scale + 40)
    ss = 2
    img = np.full((Hd * ss, Wd * ss, 3), 255, np.uint8)
    for c in T:
        pp = np.array([[tr(p)[0] * ss, tr(p)[1] * ss] for p in c["iso_polygon"]], np.int32)
        o = owners.get(c["id"])
        col = tuple(o["rgb"]) if o and o.get("rgb") else RINGCOL[c["ring"]]
        cv2.fillPoly(img, [pp], tuple(int(x) for x in col[::-1]))
        cv2.polylines(img, [pp], True, (40, 40, 40), 3 * ss // 2, cv2.LINE_AA)
    img = cv2.resize(img, (Wd, Hd), interpolation=cv2.INTER_AREA)
    im = Image.fromarray(cv2.cvtColor(img, cv2.COLOR_BGR2RGB)); d = ImageDraw.Draw(im)
    for c in T:
        poly = Polygon([tr(p) for p in c["iso_polygon"]]); inner = poly.buffer(-5)
        pl = poly.centroid
        co = list(poly.exterior.coords)[:-1]
        be = max(((co[(i + 1) % len(co)][0] - co[i][0], co[(i + 1) % len(co)][1] - co[i][1]) for i in range(len(co))), key=lambda v: math.hypot(*v))
        dx, dy = be
        if dx < 0: dx, dy = -dx, -dy
        ang = math.degrees(math.atan2(-dy, dx))
        o = owners.get(c["id"]); tag = o.get("tag") if o else None
        name = NAMES[c["ring"]]
        variants = [[name]] + ([name.split(" ", 1)] if " " in name else [])

        def attempt(tsz, var, rot):
            nsz = max(12, int(tsz * 0.62)); ft = _font(tsz); fn = _font(nsz)
            lines = ([(tag, ft)] if tag else []) + [(t, fn) for t in var]
            dims = [d.textbbox((0, 0), t, font=f) for t, f in lines]
            w = max(b[2] - b[0] for b in dims) + 10; h = sum(b[3] - b[1] + 4 for b in dims) + 8
            bx0, by0, bx1, by1 = poly.bounds; best = None
            for x in np.arange(bx0, bx1, 6):
                for y in np.arange(by0, by1, 6):
                    r = box(x - w / 2, y - h / 2, x + w / 2, y + h / 2)
                    if rot: r = affinity.rotate(r, -ang, origin=(x, y))
                    if inner.contains(r):
                        dd = math.hypot(x - pl.x, y - pl.y)
                        if best is None or dd < best[0]: best = (dd, x, y)
            return best, lines, dims, w, h
        plan = [(t, v, False) for t in (34, 30, 27, 24) for v in variants] + [(t, v, True) for t in (34, 30, 27, 24, 21, 18, 16) for v in variants] + [(t, v, False) for t in (20, 17, 15) for v in variants]
        for tsz, var, rot in plan:
            best, lines, dims, w, h = attempt(tsz, var, rot)
            if not best: continue
            _, x, y = best
            lay = Image.new("RGBA", (int(w) + 10, int(h) + 10), (0, 0, 0, 0)); ld = ImageDraw.Draw(lay); yy = 9
            for (t, f), b in zip(lines, dims):
                tw = b[2] - b[0]
                ld.text(((lay.width - tw) / 2 - b[0], yy - b[1]), t, font=f, fill=(0, 0, 0, 255), stroke_width=2, stroke_fill=(255, 255, 255, 255))
                yy += b[3] - b[1] + 4
            if rot: lay = lay.rotate(ang, expand=True, resample=Image.BICUBIC)
            im.paste(lay, (int(x - lay.width / 2), int(y - lay.height / 2)), lay)
            break
    im.save(out_png)
    return out_png
