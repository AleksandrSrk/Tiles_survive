"""Схема разметки штата 720: блоки 20x20 клеток, земли (plates), сектора.
Координаты игровые X:Y, клетки 20..1279. Данные: assets/reference/map_schema_720.json (+ sqlite рядом).
cell->block: bx=(X-20)//20, by=(Y-20)//20. Ось X растёт вправо-вверх на экране, Y влево-вверх."""
import json, os
import numpy as np
BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_S = json.load(open(os.path.join(BASE, "assets", "reference", "map_schema_720.json"), encoding="utf-8"))
PLATE = np.array(_S["blocks_plate"]); LAND = np.array(_S["blocks_land"]); N = 63
PLATES = {p["num"]: p for p in _S["plates"]}


def block_of(X, Y):
    bx, by = int((X - 20) // 20), int((Y - 20) // 20)
    return (bx, by) if 0 <= bx < N and 0 <= by < N else None


def is_land(X, Y):
    b = block_of(X, Y)
    return bool(b and LAND[b])


def plate_of(X, Y):
    """номер земли или None (вода/вне штата/щель)"""
    b = block_of(X, Y)
    return int(PLATE[b]) or None if b else None


def land_blocks():
    return [(int(bx), int(by)) for bx, by in np.argwhere(LAND == 1)]
